{
  "name": "@hipo/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_USE_MOCKS=1 vite",
    "dev:fast": "VITE_USE_MOCKS=1 VITE_AUTO_LOGIN=1 VITE_LOCALE=es vite",
    "dev:inpage": "VITE_INPAGE_BACKEND=1 vite",
    "build": "tsc --noEmit && vite build",
    "build:inpage": "cross-env VITE_INPAGE_BACKEND=1 tsc --noEmit && cross-env VITE_INPAGE_BACKEND=1 vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.2",
    "@hipo/audit": "*",
    "@hipo/auth": "*",
    "@hipo/backup": "*",
    "@hipo/backup-github": "*",
    "@hipo/backup-local": "*",
    "@hipo/backup-vault": "*",
    "@hipo/server": "*",
    "@hipo/shared": "*",
    "@hipo/sqlite": "*",
    "@hipo/sw": "*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "antd": "^6.3.7",
    "dayjs": "^1.11.20",
    "drizzle-orm": "^0.36.4",
    "hash-wasm": "^4.11.0",
    "hipo": "*",
    "i18next": "^26.1.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.7",
    "react-router": "^7.15.0",
    "sqlocal": "^0.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.0.4",
    "vitest": "^3"
  }
}
