# Node / npm / yarn
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn.lock
/.pnp
.pnp.js

# Build artifacts
/tmp
/out-tsc
dist/
apps/hipo/frontend/dist/
apps/hipo/tauri/target/
apps/hipo/tauri/gen/
